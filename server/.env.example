# Copy to .env:  cp .env.example .env
# Every line is optional locally: anything left unset falls back to a local implementation.

# --- Database ---
# Local MongoDB (Homebrew: `brew services start mongodb-community`). Run `npm run seed` once to load demo data.
MONGO_URI=mongodb://127.0.0.1:27017/pulse
# Production: MongoDB Atlas connection string.
# MONGO_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/pulse
# Unset entirely: an embedded MongoDB stored in server/.data, seeded automatically when empty.

# --- App ---
# Signs login tokens. Required in production: use a long random string (openssl rand -hex 32).
JWT_SECRET=change-me
PORT=4000
# The web app's origin(s), comma-separated, for CORS on REST and Socket.io. Not needed locally (Vite proxies /api).
# CLIENT_ORIGIN=https://pulse.vercel.app

# --- Optional services ---
# Redis: feed cache, rate limits and the Socket.io adapter. Unset = in-process memory.
# Local:      REDIS_URL=redis://127.0.0.1:6379
# Upstash:    REDIS_URL=rediss://default:password@xxxx.upstash.io:6379
# Cloudinary: media storage + CDN. Unset = files in server/uploads (wiped on each PaaS deploy).
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
# Sentry error monitoring. Unset = errors only go to the console.
# SENTRY_DSN=https://xxxx@o0.ingest.sentry.io/0

# --- Benchmarking only ---
# NO_CACHE=1
