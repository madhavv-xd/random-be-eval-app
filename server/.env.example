# --- Required in production ---
# MongoDB Atlas connection string. Leave unset locally to use a throwaway in-memory MongoDB (auto-seeded on start).
# MONGO_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/pulse
JWT_SECRET=change-me
# The web app's origin(s), comma-separated. Used for CORS on REST and Socket.io.
# CLIENT_ORIGIN=https://pulse.vercel.app
PORT=4000

# --- Optional services (each one falls back to a local implementation when unset) ---
# Upstash Redis (use the rediss:// TCP URL): feed cache, rate limits and the Socket.io adapter.
# REDIS_URL=rediss://default:password@xxxx.upstash.io:6379
# Cloudinary: media storage + CDN. Without it, uploads go to server/uploads (wiped on each PaaS deploy).
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
# Sentry error monitoring.
# SENTRY_DSN=https://xxxx@o0.ingest.sentry.io/0

# Benchmarking only: disable the cache to compare latency.
# NO_CACHE=1
